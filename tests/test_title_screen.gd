extends TestCase
## Kaya on the title screen (HD pass, phase H3): tools/art/hd_title_kaya.py's
## sheet, and where src/ui/menus/title_screen.gd puts her.
##
## The title needs the autoloads, which a headless --script run does not have,
## so its layout constants are read from source here, as
## tests/test_hud_portrait.gd reads hud.gd. The live layout (the real build
## label, the hint for the real controls) and a tap on a row are checked in the
## game by tests/integration/integration_tests.gd.

const SHEET := "res://assets/sprites/title_kaya.png"
const PALETTE := "res://assets/palette.json"
const MANIFEST := "res://assets/art_scale.json"
const TITLE := "res://src/ui/menus/title_screen.gd"
const SCREEN := Vector2(400, 240)
const FRAMES := 4

func _const(name: String) -> String:
	var re := RegEx.create_from_string("const %s := (.+)" % name)
	var m := re.search(FileAccess.get_file_as_string(TITLE))
	return "" if m == null else m.get_string(1).strip_edges()

func _f(name: String) -> float:
	return float(_const(name))

func _nums(name: String) -> PackedFloat64Array:
	var s := _const(name)                       # "Vector2(22, 62)" / "Rect2(...)"
	var inner := s.substr(s.find("(") + 1).trim_suffix(")")
	var out := PackedFloat64Array()
	for p in inner.split(","):
		out.append(float(p))
	return out

func _vec(name: String) -> Vector2:
	var n := _nums(name)
	return Vector2(n[0], n[1])

## The sheet as shipped, decoded from the PNG itself: headless, get_image() on
## a loaded texture hands back the cache Display.world_image has shrunk.
func _sheet() -> Image:
	var img := Image.new()
	if img.load_png_from_buffer(FileAccess.get_file_as_bytes(SHEET)) != OK:
		return null
	return img

## Opaque bounds of one frame, in world units relative to the cell.
func _bounds(img: Image, frame: int, cw: int) -> Rect2:
	var k := Display.art_scale()
	var lo := Vector2i(cw, img.get_height())
	var hi := Vector2i(-1, -1)
	for y in img.get_height():
		for x in cw:
			if img.get_pixel(frame * cw + x, y).a > 0.0:
				lo = Vector2i(mini(lo.x, x), mini(lo.y, y))
				hi = Vector2i(maxi(hi.x, x), maxi(hi.y, y))
	return Rect2(Vector2(lo) / k, Vector2(hi - lo + Vector2i.ONE) / k)

func test_the_sheet_is_four_frames_at_the_art_scale() -> void:
	var img := _sheet()
	ok(img != null, "title_kaya.png is generated by tools/genart.sh")
	if img == null:
		return
	var k := Display.art_scale()
	var size := _vec("KAYA_SIZE")
	eq(img.get_width(), int(size.x) * k * FRAMES, "FRAMES cells of KAYA_SIZE world units")
	eq(img.get_height(), int(size.y) * k, "one row, KAYA_SIZE tall")
	var manifest: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(MANIFEST))
	var entry: Dictionary = (manifest.get("sheets", {}) as Dictionary).get("sprites/title_kaya.png", {})
	eq(int(entry.get("scale", 0)), k, "published at the art scale")
	ok(bool(entry.get("native", false)), "and recorded as drawn natively, not upscaled")

func test_she_is_the_hero_of_the_screen() -> void:
	## The in-game sprite is 40 world units tall; on the title she is drawn at
	## four times that, so a face can have eyes, brows and a smile.
	var img := _sheet()
	if img == null:
		return
	var cw := img.get_width() / FRAMES
	for f in FRAMES:
		var b := _bounds(img, f, cw)
		gt(b.size.y, 150.0, "frame %d stands at least 150 world units tall (%.1f)" % [f, b.size.y])
		lt(b.end.y, _vec("KAYA_SIZE").y + 0.01, "and fits her cell")

func test_she_is_drawn_at_the_art_scale_not_doubled() -> void:
	## A nearest-doubled drawing is made of uniform k x k blocks. Count the
	## blocks inside her silhouette that are not: a native drawing changes
	## colour inside most of them along every line, fold and strand.
	var img := _sheet()
	if img == null:
		return
	var k := Display.art_scale()
	var mixed := 0
	var total := 0
	for by in img.get_height() / k:
		for bx in (img.get_width() / FRAMES) / k:
			var c0 := img.get_pixel(bx * k, by * k)
			if c0.a == 0.0:
				continue
			total += 1
			var same := true
			for dy in k:
				for dx in k:
					if img.get_pixel(bx * k + dx, by * k + dy) != c0:
						same = false
			if not same:
				mixed += 1
	gt(float(mixed) / float(maxi(total, 1)), 0.3,
		"over 30%% of her %d k x k blocks hold more than one colour (%d)" % [total, mixed])

func test_she_stays_on_the_ramps() -> void:
	var img := _sheet()
	if img == null:
		return
	var pal: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(PALETTE))
	var allowed := {}
	for name: String in (pal["ramps"] as Dictionary).keys():
		for c: Variant in (pal["ramps"][name] as Array):
			var a: Array = c
			allowed[Color8(int(a[0]), int(a[1]), int(a[2])).to_html(false)] = true
	var ink: Array = pal["ink"]
	allowed[Color8(int(ink[0]), int(ink[1]), int(ink[2])).to_html(false)] = true
	var strays := 0
	var partial := 0
	for y in img.get_height():
		for x in img.get_width():
			var c := img.get_pixel(x, y)
			if c.a == 0.0:
				continue
			if c.a < 1.0:
				partial += 1
			if not allowed.has(c.to_html(false)):
				strays += 1
	eq(strays, 0, "every texel is a ramp step or the ink")
	eq(partial, 0, "no texel is half transparent")

func test_the_blink_only_touches_her_eyes() -> void:
	## Frame 3 is frame 0 with her eyes shut. Everything that differs must be
	## inside KAYA_FACE, which is what the layout keeps clear.
	var img := _sheet()
	if img == null:
		return
	var cw := img.get_width() / FRAMES
	var k := float(Display.art_scale())
	var face := _nums("KAYA_FACE")
	var rect := Rect2(face[0], face[1], face[2], face[3])
	var changed := 0
	var outside := 0
	for y in img.get_height():
		for x in cw:
			if img.get_pixel(x, y) != img.get_pixel(3 * cw + x, y):
				changed += 1
				if not rect.has_point(Vector2(x, y) / k):
					outside += 1
	gt(float(changed), 0.0, "the blink frame is a different picture")
	eq(outside, 0, "and every texel it changes is inside KAYA_FACE")

func test_nothing_is_drawn_over_her() -> void:
	## Her drawn pixels, placed where the title puts them, against the right
	## column's menu rows: the menu must never sit on her.
	var img := _sheet()
	if img == null:
		return
	var cw := img.get_width() / FRAMES
	var at := _vec("KAYA_POS")
	var col := _f("COL_X")
	var half := _f("ROW_HALF_W")
	var arrow := 14.0 + 8.0                          # the ">" left of a row
	var menu := Rect2(col - half - arrow, _f("ROW0_Y"), (half + arrow) * 2.0, _f("ROW_H") * 4.0)
	for f in FRAMES:
		var b := _bounds(img, f, cw)
		b.position += at
		ok(Rect2(Vector2.ZERO, SCREEN).encloses(b), "frame %d is inside the screen: %s" % [f, b])
		ok(not b.intersects(menu), "frame %d stays clear of the menu rows: %s vs %s" % [f, b, menu])
