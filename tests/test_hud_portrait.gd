extends TestCase
## The HUD portrait (Kaya Refit phase 3): her head and shoulders beside the
## hearts, cut from the 40 px puppet by tools/art/hud_portrait.py.
##
## src/ui/hud.gd needs the autoloads, which a headless --script run does not
## have, so its layout constants are read from source here, the same way
## tests/test_parallax_bg.gd reads level.gd. The drawn result is checked in a
## real frame by tools/seq/p3_bg_hud.json (shots/p3_bg_hud_*.png).

const PORTRAIT := "res://assets/sprites/hud_portrait.png"
const PALETTE := "res://assets/palette.json"
const HUD := "res://src/ui/hud.gd"
const TOUCH := "res://src/ui/touch_controls.gd"
## The largest TOUCH SIZE the options panel allows (options_panel.gd).
const MAX_TOUCH_SCALE := 1.6
const SCREEN := Vector2(400, 240)

func _const(path: String, name: String) -> String:
	var re := RegEx.create_from_string("const %s := (.+)" % name)
	var m := re.search(FileAccess.get_file_as_string(path))
	return "" if m == null else m.get_string(1).strip_edges()

func _f(path: String, name: String) -> float:
	return float(_const(path, name))

func _portrait_rect() -> Rect2:
	var at := _const(HUD, "PORTRAIT_AT")              # "Vector2(3, 3)"
	var nums := at.trim_prefix("Vector2(").trim_suffix(")").split(",")
	var size := _f(HUD, "PORTRAIT_SIZE")
	return Rect2(float(nums[0]), float(nums[1]), size, size)

func _image() -> Image:
	var tex: Texture2D = load(PORTRAIT)
	return null if tex == null else tex.get_image()

func test_the_portrait_is_two_square_frames() -> void:
	var img := _image()
	ok(img != null, "hud_portrait.png is generated by tools/genart.sh")
	if img == null:
		return
	var size := int(_f(HUD, "PORTRAIT_SIZE"))
	eq(img.get_height(), size, "one row of frames, PORTRAIT_SIZE tall")
	eq(img.get_width(), size * 2, "two frames: smiling, eyes shut")

func test_the_wince_frame_differs_only_in_the_face() -> void:
	## Same puppet, same crop: the two frames must line up, so a wince reads as
	## her shutting her eyes and not as the picture jumping.
	var img := _image()
	if img == null:
		return
	var size := img.get_height()
	var changed := 0
	var lo := size
	var hi := -1
	for y in size:
		for x in size:
			if img.get_pixel(x, y) != img.get_pixel(x + size, y):
				changed += 1
				lo = mini(lo, y)
				hi = maxi(hi, y)
	gt(float(changed), 0.0, "the eyes-shut frame is a different picture")
	# eyes, lids and the smile, re-lit by auto_shade: ~20 of 576 pixels
	lt(float(changed), 40.0, "and only a few face pixels differ (%d)" % changed)
	ok(lo >= 6 and hi <= 16, "all of them in the face rows (%d..%d)" % [lo, hi])

func test_the_portrait_stays_on_the_ramps() -> void:
	var img := _image()
	if img == null:
		return
	var pal: Dictionary = JSON.parse_string(FileAccess.get_file_as_string(PALETTE))
	var allowed := {}
	for name: String in (pal["ramps"] as Dictionary).keys():
		for c: Variant in (pal["ramps"][name] as Array):
			var a: Array = c
			allowed[Color8(int(a[0]), int(a[1]), int(a[2])).to_html(false)] = true
	var ink: Array = pal["ink"]
	allowed[Color8(int(ink[0]), int(ink[1]), int(ink[2])).to_html(false)] = true
	var strays := {}
	for y in img.get_height():
		for x in img.get_width():
			var c := img.get_pixel(x, y)
			if c.a > 0.0 and not allowed.has(Color8(c.r8, c.g8, c.b8).to_html(false)):
				strays[c.to_html(false)] = true
	eq(strays.size(), 0, "off-ramp colours: %s" % str(strays.keys()))

func test_the_hearts_start_right_of_the_portrait() -> void:
	var r := _portrait_rect()
	gt(_f(HUD, "ROW_X"), r.end.x, "hearts and keys clear the portrait")

func test_the_portrait_is_clear_of_the_overlay_touch_layout() -> void:
	## Phones put the controls in the side margins and tablets in the bottom
	## one, both outside the world rect the HUD draws in. The only layout that
	## overlays the play area is the no-margin fallback; check it at the
	## largest touch size the options allow.
	var r := _portrait_rect()
	var s := MAX_TOUCH_SCALE
	var stick_r := _f(TOUCH, "STICK_RADIUS") * s
	var btn_r := _f(TOUCH, "BTN_R") * s
	var discs := [
		[Vector2(62.0 * s, SCREEN.y - 54.0 * s), stick_r],
		[Vector2(SCREEN.x - 44.0 * s, SCREEN.y - 40.0 * s), btn_r],
		[Vector2(SCREEN.x - 88.0 * s, SCREEN.y - 62.0 * s), btn_r],
	]
	for d: Array in discs:
		var c: Vector2 = d[0]
		var rad: float = d[1]
		var nearest := Vector2(clampf(c.x, r.position.x, r.end.x), clampf(c.y, r.position.y, r.end.y))
		gt(nearest.distance_to(c), rad, "portrait clear of the control at %s" % str(c))
