# Godot
.godot/
*.translation

# Build output. NEVER commit this: Xcode's Packaging.log contains live Apple
# auth headers (DSESSIONID, X-Apple-GS-Token). A pre-commit hook enforces it.
build/
# …except the symlink that lets Xcode Cloud find the project. It validates the
# path BEFORE ci_post_clone.sh runs, so the path must exist at clone time.
!build/ios

# If Xcode Cloud needs the generated project committed, it goes in ios/ — but
# never its logs, archives or signed artefacts.
# The Godot engine static libraries are 180 MB and 167 MB — past GitHub's
# 100 MB hard limit. ci_scripts/ci_post_clone.sh regenerates them on the build
# machine instead.
# Only the two huge ones. They are committed xz'd under ios/frameworks/ and
# reassembled by ci_scripts. The small visionos stubs are committed as-is.
ios/KayaOfTheCanopy.xcframework/
ios/MoltenVK.xcframework/
ios/**/*.log
ios/**/*.ipa
ios/**/*.xcarchive/
ios/**/*.dSYM/
ios/**/DistributionSummary.plist
ios/**/Packaging.log

# Locally installed toolchain (Godot, venv) — see tools/bootstrap.sh
.tooling/

# macOS
.DS_Store

# Local toolchain paths (machine-specific)
tools/env.sh

# Python bytecode from the generators
__pycache__/
*.pyc

# Review-only scratch images
shots/_review*.png
shots/_art_proto.png
shots/*_x3.png
