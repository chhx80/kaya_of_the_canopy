# Copy to tools/env.sh and adjust for your machine.
#
# tools/env.sh itself is gitignored because these are absolute local paths;
# every script in tools/ sources it.

# Godot 4.7.2 binary. On macOS this is inside the .app bundle:
export GODOT="$HOME/godot/Godot.app/Contents/MacOS/Godot"

# Python 3 with Pillow, used by the art/level/audio generators.
# Create it with:  python3 -m venv .venv && .venv/bin/pip install pillow
export PYVENV="$HOME/git/jungle-project/.venv/bin/python"

# Repo root.
export PROJECT_ROOT="$HOME/git/jungle-project"
